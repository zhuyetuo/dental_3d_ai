# 训练 / 评估用的 GPU 镜像：PyTorch 2.7.1 + CUDA 12.8，3090（sm_86）、4090（sm_89）、5090（sm_120）都能用。
# 代码不打进镜像：仓库挂载到 /root/zyt/dental_3d_ai（见 docker-compose.gpu.yml），改代码不用重建。
ARG REGISTRY=docker.io
FROM ${REGISTRY}/pytorch/pytorch:2.7.1-cuda12.8-cudnn9-devel

ENV PIP_NO_CACHE_DIR=1 PYTHONUNBUFFERED=1 DEBIAN_FRONTEND=noninteractive \
    TORCH_CUDA_ARCH_LIST="8.6;8.9;9.0;12.0" \
    PYTHONPATH=/root/zyt/dental_3d_ai/ml
RUN apt-get update && apt-get install -y --no-install-recommends git wget curl libgl1 libglib2.0-0 libspatialindex-dev fonts-noto-cjk \
    && rm -rf /var/lib/apt/lists/*
# ml/ 的依赖 + 训练、出图、评估脚本用到的
RUN pip install "numpy>=1.24,<2.3" "scipy>=1.10" "trimesh>=4.0" "networkx>=3.0" "rtree>=1.0" "scikit-learn>=1.3" \
    matplotlib shapely pytest "fast-simplification" "pyyaml" "tqdm"
WORKDIR /root/zyt/dental_3d_ai
